{
  // packages/react는 .ts 소스로 배포되므로 React 18 타입을 쓰는 소비자에서도 컴파일돼야 한다.
  // "react"를 이 폴더의 @types/react@18로 돌려 래퍼 소스를 타입 검사한다(`npm run typecheck:react18`).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "files": ["../../packages/react/src/index.ts"]
}

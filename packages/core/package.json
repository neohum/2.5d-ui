  "license": "MIT",
  "type": "module",
  "main": "./dist/iso.min.js",
  "style": "./dist/iso.min.css",
  "exports": {
    ".": "./dist/iso.min.js",
    "./css": "./dist/iso.min.css",
    "./edu": "./dist/iso-edu.min.js",
    "./edu/css": "./dist/iso-edu.min.css",
    "./edu/city": "./dist/iso-edu-city.min.js",
    "./edu/layers": "./dist/iso-edu-layers.min.js",

{
  "name": "2.5d-ui-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 4173",
    "site": "vite site",
    "site:build": "vite build site",
    "build": "npm run build -w packages/core",
    "publish:core": "npm run build && npm publish -w packages/core --access public",
    "publish:core:dry": "npm run build && npm publish -w packages/core --dry-run",
    "test": "vitest run",
    "pretest:react18": "npm ci --prefix tests/react18 --no-audit --no-fund",
    "test:react18": "vitest run --config tests/react18/vitest.config.ts && npm run typecheck:react18",
    "typecheck:react18": "tsc -p tests/react18/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "stylelint \"packages/*/src/**/*.css\" && npm run typecheck",
    "size": "npm run build && size-limit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "^11.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0",
    "lightningcss": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^11.2.0",
    "stylelint": "^16.23.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
